@model TodoMVC.Models.Producto

@{
    ViewData["Title"] = "Nuevo Producto";
}

<div class="container container-sm">
    <h1>Nuevo Producto</h1>

    <form method="post" action="/Productos/Crear">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label for="Nombre">Nombre del producto</label>
            <input type="text" id="Nombre" name="Nombre" placeholder="Ej: Leche, Huevos..." autofocus required />
        </div>

        <div class="form-group" style="margin-top: 15px;">
            <label for="Cantidad">Cantidad</label>
            <input type="number" id="Cantidad" name="Cantidad" value="1" min="1" required />
        </div>

        <div class="form-actions" style="margin-top: 20px;">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a href="/Productos/Index" class="btn">Cancelar</a>
        </div>
    </form>
</div>